# ==========================================
# NILO - AGENTIC LEARNING OS (ENV TEMPLATE)
# Copy this file to .env and configure your keys
# ==========================================

# Supabase Auth & Database Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# AI Model Providers (Groq / Gemini / OpenAI)
VITE_GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Voice & Speech Service (Optional)
VITE_SPEECH_SERVICE_REGION=us-east-1
VITE_SPEECH_SERVICE_KEY=your_speech_key_here
